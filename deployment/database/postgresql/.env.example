# ====================================
# PostgreSQL 資料庫設定範例
# ====================================
#
# 使用方式:
#   1. 複製此檔案為 .env
#   2. 修改下列設定
#   3. docker-compose up -d
#

# ==========================================
# 資料庫連線設定
# ==========================================
POSTGRES_DB=tw_stock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here  # ⚠️ 請務必修改

# ==========================================
# 連接埠設定
# ==========================================
POSTGRES_PORT=5432

# ==========================================
# 網路設定
# ==========================================
NETWORK_NAME=tw-stock-network

# ==========================================
# 備份設定（選用）
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨 2:00 備份
BACKUP_RETENTION_DAYS=30     # 保留 30 天

# ==========================================
# 效能調校（進階，選用）
# ==========================================
# 這些參數可在 docker-compose.yml 中透過 command 覆寫
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# POSTGRES_WORK_MEM=16MB
# POSTGRES_MAINTENANCE_WORK_MEM=128MB
