# ====================================
# 資料匯入管道設定範例
# ====================================
#
# 使用方式:
#   1. 複製此檔案為 .env
#   2. 修改下列設定
#   3. docker-compose up -d
#

# ==========================================
# 資料庫連線設定
# ==========================================
POSTGRES_DB=tw_stock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here  # ⚠️ 請務必修改
POSTGRES_PORT=5432

# ==========================================
# 網路設定
# ==========================================
NETWORK_NAME=tw-stock-network

# ==========================================
# 資料收集器參數
# ==========================================
# 範例:
# COLLECTOR_ARGS=--date 2024-12-27
# COLLECTOR_ARGS=--date 2024-12-27 --types price margin
# COLLECTOR_ARGS=--skip-trading-day-check
COLLECTOR_ARGS=

# ==========================================
# 資料匯入器參數
# ==========================================
# 範例:
# IMPORTER_ARGS=--date 2024-12-27
# IMPORTER_ARGS=--date 2024-12-27 --types price institutional
# IMPORTER_ARGS=--start 2024-12-01 --end 2024-12-31
IMPORTER_ARGS=

# ==========================================
# 日誌設定
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ==========================================
# 使用範例
# ==========================================
#
# 1. 收集並匯入今日資料:
#    COLLECTOR_ARGS=
#    IMPORTER_ARGS=
#
# 2. 收集並匯入指定日期:
#    COLLECTOR_ARGS=--date 2024-12-27
#    IMPORTER_ARGS=--date 2024-12-27
#
# 3. 回補歷史資料:
#    COLLECTOR_ARGS=--start 2024-12-01 --end 2024-12-31
#    IMPORTER_ARGS=--start 2024-12-01 --end 2024-12-31
#
# 4. 只收集特定類型:
#    COLLECTOR_ARGS=--date 2024-12-27 --types price margin
#    IMPORTER_ARGS=--date 2024-12-27 --types price margin
